<div id="blogArchiveSection" ng-controller="BlogController" ng-init="getArchiveDates('@ViewBag.BlogSubFolder');">
    <div class="space-y-3">
        <div ng-repeat="archiveItem in archiveDates.ListItems" class="group">
            <a href="/{{ archiveItem.RelatedLink }}" class="flex items-center justify-between p-3 rounded-xl hover:bg-blue-50 transition-colors border border-transparent hover:border-blue-100">
                <span class="text-sm font-bold text-slate-700 group-hover:text-blue-600 transition-colors">{{ archiveItem.Name }}</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-slate-300 group-hover:text-blue-600 group-hover:translate-x-1 transition-all"><path d="m9 18 6-6-6-6"/></svg>
            </a>
        </div>
    </div>
</div>
