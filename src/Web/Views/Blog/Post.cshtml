@model AlwaysMoveForward.AnotherBlog.Web.Models.BlogModels.BlogPostModel
           
@using AlwaysMoveForward.AnotherBlog.Common.DomainModel;
@using AlwaysMoveForward.AnotherBlog.Web.Code.Utilities;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = AlwaysMoveForward.AnotherBlog.Web.WebApplicationState.SiteInfo.Name + " - " + Model.Post.Title;
    ViewBag.Description = Model.Post.ShortEntryText;
    ViewBag.Author = Model.Author.GetDisplayName();
    ViewBag.Common = Model.BlogCommon.Common;
    ViewBag.BlogCommon = Model.BlogCommon;
    ViewBag.BlogSubFolder = Model.BlogCommon.TargetBlog.SubFolder;
}

@section headerPlugins
{
    <script src="@Url.Content("~/Scripts/Controllers/CommentController.js")" type="text/javascript"></script>
}

<article class="bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden">
    <div class="p-6 md:p-10">
        <!-- Post Header -->
        <header class="mb-2">
            <div class="flex items-center gap-2 mb-4">
                <span class="text-[10px] font-bold text-blue-600 uppercase tracking-widest px-2 py-0.5 bg-blue-50 rounded">
                    @Model.BlogCommon.TargetBlog.Name
                </span>
                <time class="text-xs font-semibold text-slate-400">@Model.Post.DatePosted.ToLongDateString()</time>
            </div>

            <h1 class="text-2xl md:text-4xl font-bold text-slate-900 tracking-tight leading-tight mb-4">
                @Model.Post.Title
            </h1>

            <div class="text-sm font-medium text-slate-400 border-b border-slate-50 pb-1">
                By <span class="font-bold text-slate-700">@Model.Author.GetDisplayName()</span> &bull; Author
            </div>
        </header>

        <!-- Post Content -->
        <div class="ql-snow">
            <div class="ql-editor public-post-content text-slate-700 leading-relaxed mb-10">
                @Html.Raw(Model.Post.EntryText)
            </div>
        </div>

        <style>
            /* Tighten spacing */
            .public-post-content.ql-editor > *:first-child {
                margin-top: 0 !important;
            }
            /* Ultimate fallback to ensure bullets and numbers are visible */
            .public-post-content.ql-editor ul, 
            .public-post-content.ql-editor ol {
                list-style-position: inside !important;
                padding-left: 0 !important;
            }
            .public-post-content.ql-editor li {
                display: list-item !important;
            }
        </style>
    </div>
</article>

<!-- Post Navigation -->
<div class="grid grid-cols-2 gap-4 pt-8">
    <div>
        @if (Model.PreviousEntry != null)
        {
            <a href="@Utils.GenerateBlogEntryLink(Model.BlogCommon.TargetBlog.SubFolder, Model.PreviousEntry)" class="group block p-5 bg-white rounded-lg border border-slate-200 hover:border-blue-200 transition-colors shadow-sm">
                <span class="text-[9px] font-bold text-slate-400 uppercase tracking-widest block mb-1 text-center md:text-left">Previous Article</span>
                <span class="text-xs font-bold text-slate-900 group-hover:text-blue-600 transition-colors line-clamp-1">@Model.PreviousEntry.Title</span>
            </a>
        }
    </div>
    <div class="text-right">
        @if (Model.NextEntry != null)
        {
            <a href="@Utils.GenerateBlogEntryLink(Model.BlogCommon.TargetBlog.SubFolder, Model.NextEntry)" class="group block p-5 bg-white rounded-lg border border-slate-200 hover:border-blue-200 transition-colors shadow-sm">
                <span class="text-[9px] font-bold text-slate-400 uppercase tracking-widest block mb-1 text-center md:text-right">Next Article</span>
                <span class="text-xs font-bold text-slate-900 group-hover:text-blue-600 transition-colors line-clamp-1">@Model.NextEntry.Title</span>
            </a>
        }
    </div>
</div>

<!-- Comments Section -->
<section class="mt-12 space-y-8 hidden" ng-controller="CommentController">
    <div class="flex items-center justify-between border-b border-slate-200 pb-4">
        <h3 class="text-xl font-bold text-slate-800 tracking-tight">Discussion (@Model.Post.CommentCount)</h3>
    </div>

    <div class="space-y-4">
        <partial name="ViewComments" model="Model.Post.Id" />
    </div>

    <!-- Add Comment Form -->
    <div class="bg-white rounded-lg border border-slate-200 p-6 md:p-8 shadow-sm">
        <h4 class="text-lg font-bold text-slate-900 mb-6">Leave a comment</h4>
        <form name="submitCommentForm" class="space-y-5">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                    <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1.5">Name</label>
                    <input type="text" ng-model="authorName" required class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg focus:border-blue-500 outline-none transition-all text-sm" placeholder="Your name" />
                </div>
                <div>
                    <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1.5">Email</label>
                    <input type="email" ng-model="authorEmail" required class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg focus:border-blue-500 outline-none transition-all text-sm" placeholder="your@email.com" />
                </div>
            </div>
            
            <div>
                <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1.5">Comment</label>
                <textarea ng-model="commentText" required rows="4" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg focus:border-blue-500 outline-none transition-all text-sm" placeholder="Write your thoughts..."></textarea>
            </div>

            <div class="pt-2">
                <button type="button" 
                        class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg shadow hover:-translate-y-0.5 transition-all disabled:opacity-50 disabled:translate-y-0 text-xs uppercase tracking-wider"
                        ng-click="submitComment('@ViewBag.BlogSubFolder', '@Model.Post.Id.ToString()');" 
                        ng-disabled="submitCommentForm.$invalid">
                    Post Comment
                </button>
            </div>
        </form>
    </div>
</section>
