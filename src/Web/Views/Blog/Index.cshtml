@model AlwaysMoveForward.AnotherBlog.Web.Models.BlogModels.BlogModel

@using AlwaysMoveForward.AnotherBlog.Common.DomainModel;
@using AlwaysMoveForward.AnotherBlog.Web.Code.Utilities;
@using AlwaysMoveForward.AnotherBlog.Web.Models.BlogModels;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = AlwaysMoveForward.AnotherBlog.Web.WebApplicationState.SiteInfo.Name + " - " + Model.BlogCommon.TargetBlog.Name;
    ViewBag.Description = Model.BlogCommon.TargetBlog.Description;
    ViewBag.Author = AlwaysMoveForward.AnotherBlog.Web.WebApplicationState.SiteInfo.DefaultAuthor;
    ViewBag.Keywords = AlwaysMoveForward.AnotherBlog.Web.WebApplicationState.SiteInfo.DefaultKeywords;
    ViewBag.Common = Model.BlogCommon.Common;
    ViewBag.BlogCommon = Model.BlogCommon;
    ViewBag.BlogSubFolder = Model.BlogCommon.TargetBlog.SubFolder;
}

<div class="space-y-6">        
    @if (!string.IsNullOrEmpty(Model.BlogCommon.Common.ContentTitle))
    {
        <h2 class="text-2xl font-bold text-slate-800 tracking-tight mb-4">@Model.BlogCommon.Common.ContentTitle</h2>
    }

    @if (Model.BlogCommon.TargetBlog != null)
    {
        if (Model.BlogEntries.Count > 0)
        {
            foreach (BlogPostModel blogPost in Model.BlogEntries)
            { 
                <article class="bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden transition-all hover:border-slate-300">
                    <div class="p-6 md:p-8">
                        <div class="flex items-center gap-2 mb-4">
                            <span class="text-[10px] font-bold text-blue-600 uppercase tracking-widest px-2 py-0.5 bg-blue-50 rounded">
                                @Model.BlogCommon.TargetBlog.Name
                            </span>
                            <time class="text-xs font-semibold text-slate-400">@blogPost.Post.DatePosted.ToLongDateString()</time>
                        </div>

                        <h3 class="text-xl md:text-2xl font-bold text-slate-900 mb-3 leading-tight">
                            <a href="@Utils.GenerateBlogEntryLink(Model.BlogCommon.TargetBlog.SubFolder, blogPost.Post)" class="hover:text-blue-600 transition-colors">
                                @blogPost.Post.Title
                            </a>
                        </h3>

                        <div class="ql-snow">
                            <div class="ql-editor !p-0 text-slate-600 mb-6 text-sm md:text-base leading-relaxed">
                                @Html.Raw(blogPost.Post.ShortEntryText)
                            </div>
                        </div>                  

                        <div class="flex items-center justify-between pt-6 border-t border-slate-50">
                            <div class="text-xs font-medium text-slate-400">
                                By <span class="font-bold text-slate-700">@blogPost.Author.GetDisplayName()</span> &bull; @blogPost.Post.CommentCount Comments
                            </div>

                            <a href="@Utils.GenerateBlogEntryLink(Model.BlogCommon.TargetBlog.SubFolder, blogPost.Post)" class="inline-flex items-center gap-1.5 text-xs font-bold text-blue-600 uppercase tracking-wider hover:text-blue-700 transition-colors">
                                Continue Reading
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                            </a>
                        </div>
                    </div>
                </article>
            }
            <div class="pt-6">
                @Html.PagedListPager(Model.BlogEntries, page => Url.Action("Index", new { page }), new PagedListRenderOptions
                {
                    UlElementClasses = new[] { "flex", "justify-center", "gap-1" },
                    LiElementClasses = new[] { "list-none" },
                    PageClasses = new[] { "flex", "items-center", "justify-center", "min-w-[40px]", "h-10", "px-3", "rounded-lg", "border", "border-slate-200", "bg-white", "text-sm", "font-semibold", "text-slate-700", "hover:bg-slate-50", "hover:border-slate-300", "transition-all" },
                    ActiveLiElementClass = "[&>a]:bg-blue-600 [&>a]:text-white [&>a]:border-blue-600 [&>span]:bg-blue-600 [&>span]:text-white [&>span]:border-blue-600"
                })
            </div>
        }
        else
        {
            <div class="bg-white rounded-lg p-10 text-center border-2 border-dashed border-slate-200">
                <p class="text-slate-400 font-semibold">There are no entries for this blog.</p>
            </div>
        } 
    }
</div>
