<div id="blogTagSection" ng-controller="BlogController" ng-init="getBlogTags('@ViewBag.BlogSubFolder');">
    <div class="flex flex-wrap gap-2">
        <div ng-repeat="tagItem in blogTags">
            <a href="/Blog/@ViewBag.BlogSubFolder/Tag/{{tagItem.Name}}" class="inline-flex items-center px-4 py-2 bg-slate-50 hover:bg-blue-600 text-slate-500 hover:text-white text-xs font-bold rounded-xl transition-all border border-slate-100 uppercase tracking-wide">
                {{ tagItem.Name }}
            </a>
        </div>
    </div>
</div>
