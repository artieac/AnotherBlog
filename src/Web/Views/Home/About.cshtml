@model AlwaysMoveForward.AnotherBlog.Web.Models.Home.SiteModel
@using AlwaysMoveForward.AnotherBlog.Common.DomainModel;
@using AlwaysMoveForward.AnotherBlog.Web.Code.Utilities;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = AlwaysMoveForward.AnotherBlog.Web.WebApplicationState.SiteInfo.Name;
    ViewBag.Description = AlwaysMoveForward.AnotherBlog.Web.WebApplicationState.SiteInfo.About;
    ViewBag.Author = AlwaysMoveForward.AnotherBlog.Web.WebApplicationState.SiteInfo.DefaultAuthor;
    ViewBag.Keywords = AlwaysMoveForward.AnotherBlog.Web.WebApplicationState.SiteInfo.DefaultKeywords;
    ViewBag.Common = @Model.Common;
}
<div class="bodyContent">        
    <div class="contentPageTitle">
        <label>@Model.Common.ContentTitle</label>
    </div> 
    <div class="aboutContent ql-snow">
        <div class="ql-editor public-post-content p-0 text-slate-700 leading-relaxed">
            @Html.Raw(Model.SiteInfo.About)
        </div>
    </div>

    <style>
        /* Ultimate fallback to ensure bullets and numbers are visible */
        .public-post-content.ql-editor ul, 
        .public-post-content.ql-editor ol {
            list-style-position: inside !important;
            padding-left: 0 !important;
        }
        .public-post-content.ql-editor li {
            display: list-item !important;
        }
    </style>
</div>
