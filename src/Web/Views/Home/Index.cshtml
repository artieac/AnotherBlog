@model AlwaysMoveForward.AnotherBlog.Web.Models.Home.IndexModel
@using AlwaysMoveForward.AnotherBlog.Common.DomainModel
@using AlwaysMoveForward.AnotherBlog.Web.Code.Utilities
@using AlwaysMoveForward.AnotherBlog.Web.Models.BlogModels
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = AlwaysMoveForward.AnotherBlog.Web.WebApplicationState.SiteInfo.Name;
    ViewBag.Description = AlwaysMoveForward.AnotherBlog.Web.WebApplicationState.SiteInfo.About;
    ViewBag.Author = AlwaysMoveForward.AnotherBlog.Web.WebApplicationState.SiteInfo.DefaultAuthor;
    ViewBag.Keywords = AlwaysMoveForward.AnotherBlog.Web.WebApplicationState.SiteInfo.DefaultKeywords;
    ViewBag.Common = Model.Common;
}

<div class="space-y-6">        
    @if (!string.IsNullOrEmpty(Model.Common.ContentTitle))
    {
        <h1 class="text-2xl font-bold text-slate-800 tracking-tight mb-4">@Model.Common.ContentTitle</h1>
    }

    @if(Model.BlogEntries.Count > 0)
    {
        foreach (BlogPostModel blogPost in Model.BlogEntries)
        {                    
            <article class="bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden transition-all hover:border-slate-300">
                <div class="p-6 md:p-8">
                    <div class="flex items-center gap-2 mb-4">
                        <span class="text-[10px] font-bold text-blue-600 uppercase tracking-widest px-2 py-0.5 bg-blue-50 rounded">
                            @blogPost.Post.Blog.Name
                        </span>
                        <time class="text-xs font-semibold text-slate-400">@blogPost.Post.DatePosted.ToLongDateString()</time>
                    </div>

                    <h3 class="text-xl md:text-2xl font-bold text-slate-900 mb-3 leading-tight">
                        <a href="@Utils.GenerateBlogEntryLink(blogPost.Post.Blog.SubFolder, blogPost.Post)" class="hover:text-blue-600 transition-colors">
                            @blogPost.Post.Title
                        </a>
                    </h3>

                    <div class="text-slate-600 mb-6 text-sm md:text-base leading-relaxed whitespace-normal">
                        @Html.Raw(blogPost.Post.ShortEntryText)
                    </div>                  

                    <div class="flex items-center justify-between pt-6 border-t border-slate-50">
                        <div class="text-xs font-medium text-slate-400">
                            By <span class="font-bold text-slate-700">@blogPost.Author.GetDisplayName()</span> &bull; @blogPost.Post.CommentCount Comments
                        </div>

                        <a href="@Utils.GenerateBlogEntryLink(blogPost.Post.Blog.SubFolder, blogPost.Post)" class="inline-flex items-center gap-1.5 text-xs font-bold text-blue-600 uppercase tracking-wider hover:text-blue-700 transition-colors">
                            Continue Reading
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                        </a>
                    </div>
                </div>
            </article>
        }
    }
    else
    {
        <div class="bg-white rounded-lg p-10 text-center border-2 border-dashed border-slate-200">
            <p class="text-slate-400 font-semibold">There are no entries for this blog.</p>
        </div>
    }
</div>
