@using AlwaysMoveForward.AnotherBlog.Web
@using AlwaysMoveForward.AnotherBlog.Web.Models
@using AlwaysMoveForward.AnotherBlog.Web.Code.Utilities
@using AlwaysMoveForward.AnotherBlog.Web.Code.Extensions
@using AlwaysMoveForward.AnotherBlog.Common.DomainModel

@{
    Layout = "~/Views/Shared/_CommonLayout.cshtml";
}

@section headerPlugins
{
    <script src="@Url.Content("~/Scripts/Controllers/ListController.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/Controllers/BlogController.js")" type="text/javascript"></script>
    @RenderSection("headerPlugins", false)
}

<div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
    <!-- Main Content Area -->
    <div class="lg:col-span-8">
        <div class="space-y-8">
            @RenderBody()
        </div>
    </div>

    <!-- Sidebar / Meta Content -->
    <aside class="lg:col-span-4 space-y-6">   
        <div class="bg-white rounded-lg border border-slate-200 overflow-hidden shadow-sm">
            <partial name="_BlogSelectionControl"/>
        </div>
        
        <div class="bg-white rounded-lg border border-slate-200 p-5 shadow-sm">
            <h3 class="text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-4 border-b border-slate-100 pb-3">Calendar</h3>
            <partial name="_CalendarControl" model="(AlwaysMoveForward.AnotherBlog.Web.Models.CalendarModel)ViewBag.Common.Calendar"/>
        </div>

        <div id="mostViewed" ng-controller="ListController" class="bg-white rounded-lg border border-slate-200 p-5 shadow-sm">
            <div ng-init="getMostViewedPosts('@ViewBag.BlogSubFolder');">
                <h3 class="text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-4 border-b border-slate-100 pb-3">{{ mostViewedPosts.Title }}</h3>
                <div class="space-y-3">
                    <div ng-repeat="listItem in mostViewedPosts.ListItems">
                        <a href="{{ listItem.RelatedLink }}" class="text-sm font-semibold text-slate-700 hover:text-blue-600 transition-colors block leading-snug">
                            {{ listItem.Name }}
                        </a>
                    </div>
                </div>
            </div>    
        </div>                     

        @if(ViewBag.BlogSubFolder != null && !string.IsNullOrEmpty((string)ViewBag.BlogSubFolder))
        {
            <div class="bg-white rounded-lg border border-slate-200 p-5 shadow-sm">
                <h3 class="text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-4 border-b border-slate-100 pb-3">Tags</h3>
                <partial name="_TagControl" />
            </div>
            
            <div class="bg-white rounded-lg border border-slate-200 p-5 shadow-sm">
                <partial name="_BlogListsControl" />
            </div>

            <div class="bg-white rounded-lg border border-slate-200 p-5 shadow-sm">
                <h3 class="text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-4 border-b border-slate-100 pb-3">Archives</h3>
                <partial name="_ArchiveControl" />
            </div>
        }

        <div class="bg-slate-800 rounded-lg p-5 text-white shadow-sm">
            <partial name="_SyndicationControl" model="ViewBag.BlogSubFolder == null ? string.Empty : (string)ViewBag.BlogSubFolder" />
        </div>   
    </aside>
</div>
