@model string
<div id="blogSyndicationSection">
    <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-6 border-b border-slate-800 pb-4">Subscribe</h3>
    <div class="space-y-4">
        <a href='/RSS/SiteRSS' class="flex items-center gap-4 p-4 rounded-2xl bg-slate-800/50 hover:bg-blue-600 transition-all group">
            <div class="w-10 h-10 rounded-xl bg-slate-700 flex items-center justify-center group-hover:bg-white/20 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-orange-500 group-hover:text-white"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
            </div>
            <div class="flex flex-col">
                <span class="text-sm font-bold text-white">Full Site RSS</span>
                <span class="text-[10px] font-bold text-slate-500 group-hover:text-white/60 uppercase tracking-wider">Stay Updated</span>
            </div>
        </a>

        @if (!string.IsNullOrEmpty(Model))
        {
            <a href='/RSS/BlogRSS/@Model' class="flex items-center gap-4 p-4 rounded-2xl bg-slate-800/50 hover:bg-blue-600 transition-all group">
                <div class="w-10 h-10 rounded-xl bg-slate-700 flex items-center justify-center group-hover:bg-white/20 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-blue-400 group-hover:text-white"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
                </div>
                <div class="flex flex-col">
                    <span class="text-sm font-bold text-white">Current Blog RSS</span>
                    <span class="text-[10px] font-bold text-slate-500 group-hover:text-white/60 uppercase tracking-wider">Specific Feed</span>
                </div>
            </a>
        }
    </div>
</div>
