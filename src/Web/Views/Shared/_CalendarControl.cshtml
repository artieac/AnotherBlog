@model AlwaysMoveForward.AnotherBlog.Web.Models.CalendarModel
@using AlwaysMoveForward.AnotherBlog.Web
<div class="contentSection bg-white rounded-lg overflow-hidden border border-slate-100 shadow-sm">
    <div class="monthTitle flex items-center justify-between p-3 bg-slate-50 border-b border-slate-100">
        <a class="changeMonth p-1 hover:bg-slate-200 rounded transition-colors text-slate-600" href="@Model.GenerateUrlForMonth(-1)">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </a>
        <a class="currentMonth text-xs font-bold text-slate-700 uppercase tracking-wider" href="@Model.GenerateUrlForMonth(0)">@Model.TargetMonth.ToString("MMMM yyyy")</a>
        <a class="changeMonth p-1 hover:bg-slate-200 rounded transition-colors text-slate-600" href="@Model.GenerateUrlForMonth(1)">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </a>
    </div>     
    <table class="calendarDates w-full border-collapse">
        <thead>
            <tr class="text-[10px] font-bold text-slate-400 uppercase tracking-tighter bg-slate-50/50">
                <th class="py-2 text-center border-b border-slate-50">Su</th>
                <th class="py-2 text-center border-b border-slate-50">Mo</th>
                <th class="py-2 text-center border-b border-slate-50">Tu</th>
                <th class="py-2 text-center border-b border-slate-50">We</th>
                <th class="py-2 text-center border-b border-slate-50">Th</th>
                <th class="py-2 text-center border-b border-slate-50">Fr</th>
                <th class="py-2 text-center border-b border-slate-50">Sa</th>
            </tr>
        </thead>
        <tbody>
        @for (int weekIndex = 0; weekIndex < 6; weekIndex++)
        {
            <tr class="weekRow">
            @for(int i= 0; i < 7; i++)
            {
                string cellClasses = "weekDayCell h-9 w-9 text-[11px] text-center transition-all border border-slate-50 ";

                if (Model.TrackingDate.Month == ViewData.Model.TargetMonth.Month)
                {
                    cellClasses += "weekDayCellThisMonth text-slate-700 ";
                }
                else
                {
                    cellClasses += "weekdayCellOtherMonth text-slate-300 bg-slate-50/30 ";
                }

                if (Model.TrackingDate.Date == DateTime.Now.Date)
                {
                    cellClasses += "weekDayCellCurrentDay font-black text-blue-600 ring-2 ring-inset ring-blue-100 ";
                }

                if (ViewData.Model.CurrentMonthBlogDates.Contains(Model.TrackingDate, new AlwaysMoveForward.Common.Utilities.DateCompare()))
                {
                    cellClasses += "weekdayCellSelected bg-blue-600 text-white font-bold hover:bg-blue-700 ";
                    <td class="@cellClasses">
                        <a href="@ViewData.Model.GenerateUrlForDay(Model.TrackingDate)" class="block w-full h-full flex items-center justify-center text-white no-underline">
                            @Model.TrackingDate.Day
                        </a>
                    </td>
                }
                else
                {
                    <td class="@cellClasses">
                        <div class="flex items-center justify-center w-full h-full">@Model.TrackingDate.Day</div>
                    </td>
                }
                Model.TrackingDate = Model.TrackingDate.AddDays(1);                    
            }
            </tr>
        }
        </tbody>
   </table>
</div>
