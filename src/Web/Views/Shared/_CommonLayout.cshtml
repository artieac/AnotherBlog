@using AlwaysMoveForward.AnotherBlog.Web
@using AlwaysMoveForward.AnotherBlog.Web.Code.Extensions
@using System.Collections.Generic
@using AlwaysMoveForward.AnotherBlog.Common.DomainModel
@using AlwaysMoveForward.AnotherBlog.Web.Code.Utilities
@inject PageManager PageManager

<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    <meta name="author" content="@ViewBag.Author" />
    <meta name="description" content="@ViewBag.Description" />
    <meta content="@ViewBag.Author, @ViewBag.KeyWords" name="keywords" />
    
    <!-- Modern Tailwind CSS -->
    <link href="/css/global.css?v=@WebApplicationState.Version" rel="stylesheet" />
    
    <!-- Quill Snow Theme for content rendering -->
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet">
    
    <!-- Core Scripts -->
    <script src="@Url.Content("~/Scripts/jquery-1.9.1.js")?v=@WebApplicationState.Version"></script>
    <script src="@Url.Content("~/Scripts/angular.min.js")?v=@WebApplicationState.Version"></script>
    <script src="@Url.Content("~/Scripts/angular-resource.js")?v=@WebApplicationState.Version"></script>
    <script src="@Url.Content("~/Scripts/Modules/ServiceDefinitionModule.js")?v=@WebApplicationState.Version"></script>
    <script src="@Url.Content("~/Scripts/Common/SiteLogin.js")?v=@WebApplicationState.Version"></script>

    <!-- Legacy support for Pager -->
    <link href="@Url.Content("~/Content/themes/" + PageManager.GetCurrentTheme(ViewBag.Common) + "/Pager.css")?v=@WebApplicationState.Version" rel="stylesheet" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-J7V3FD2TRC"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-J7V3FD2TRC');
    </script>
    @RenderSection("headerPlugins", false)
</head>
<body class="h-full text-slate-800 antialiased" ng-app="theApp">
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-J7V3FD2TRC"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-J7V3FD2TRC');
    </script>
    <!-- Streamlined Header with Centered Background -->
    <header class="relative w-full h-[280px] overflow-hidden bg-slate-900 flex items-start justify-center">
        <!-- Centered Background Image -->
        <div class="absolute inset-0 z-0">
            <img src="/Content/images/header.jpg" alt="" class="w-full h-full object-cover object-center" />
            <div class="absolute inset-0 bg-black/20"></div>
        </div>

        <div class="relative z-10 w-full max-w-6xl mx-auto px-6 pt-6 flex justify-end">
            <div id="loginSection">
                <partial name="_UserLoginControl" model="String.Empty" />
            </div>
        </div>
    </header>

    <!-- Clean Navigation Tabs -->
    <nav class="sticky top-0 z-30 w-full bg-white border-b border-slate-200">
        <div class="max-w-6xl mx-auto px-6">
            @{
                TabElements tabElements = new TabElements();
                tabElements.Add("Home", "/Home/Index", "");
                if (PageManager.CanAccessAdminTool())
                {
                    tabElements.Add("Admin Tool", "/Admin/App", "");
                }
                tabElements.Add("About", "/Home/About", "");
                tabElements.SetSelectedTab(new Uri($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}{Context.Request.QueryString}"));
            }
            <div class="flex justify-center space-x-10 h-14 items-center">
                @foreach (var tab in tabElements.TabItems)
                {
                    bool isActive = tabElements.TabItems.IndexOf(tab) == tabElements.SelectedTab;
                    <a href="@tab.TargetUrl" class="@(isActive ? "text-blue-600 border-b-2 border-blue-600 font-bold" : "text-slate-500 hover:text-slate-800 font-medium transition-colors") py-4 px-1 text-sm tracking-wide">
                        @tab.Title
                    </a>
                }
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="max-w-6xl mx-auto px-6 py-10">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 mt-auto py-12">
        <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center text-slate-500 text-sm font-medium">
            <div>&copy; @DateTime.Now.Year @WebApplicationState.SiteInfo.Name. All rights reserved.</div>
            <div class="mt-4 md:mt-0">
                <a href="/Home/About" class="hover:text-blue-600">About @WebApplicationState.SiteInfo.Name</a>
            </div>
        </div>
    </footer>
</body>
</html>
