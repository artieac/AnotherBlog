@model AlwaysMoveForward.AnotherBlog.Web.Models.UserModel
@{
    ViewBag.Title = "User Preferences";
    ViewBag.Common = Model.Common;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section headerPlugins
{
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var quill = new Quill('#editor-container', {
                theme: 'snow',
                modules: {
                    toolbar: [
                        [{ 'header': [1, 2, false] }],
                        ['bold', 'italic', 'underline'],
                        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                        ['link', 'image'],
                        ['clean']
                    ]
                }
            });

            quill.root.innerHTML = document.getElementById('userAbout').value;

            quill.on('text-change', function() {
                var html = quill.root.innerHTML;
                document.getElementById('userAbout').value = html;
            });
        });
    </script>
}

<div class="max-w-4xl mx-auto">
    <div class="mb-8">
        <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">@Model.Common.ContentTitle</h2>
        <p class="text-slate-500 mt-2 font-medium">Manage your personal settings and profile information.</p>
    </div>

    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        @{
            var formAction = Model.TargetBlog == null ? "/User/SavePreferences" : $"/{Model.TargetBlog.SubFolder}/User/SavePreferences";
        }
        <form action="@formAction" method="post" class="divide-y divide-slate-100">
            <!-- Account Info Section -->
            <div class="p-6 md:p-8 space-y-8">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start">
                    <div>
                        <h4 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Account Identity</h4>
                        <p class="text-xs text-slate-400 mt-1 font-medium">Your unique identifier and public name.</p>
                    </div>
                    <div class="md:col-span-2 space-y-6">
                        <div>
                            <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1.5">User Name</label>
                            <div class="px-4 py-3 bg-slate-50 border border-slate-100 rounded-lg text-sm font-bold text-slate-500">
                                @Model.CurrentUser.GetDisplayName()
                            </div>
                        </div>

                        <div>
                            <label for="displayName" class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1.5">Display Name</label>
                            <input type="text" id="displayName" name="displayName" value="@Model.CurrentUser.GetDisplayName()" 
                                   class="w-full px-4 py-3 bg-white border border-slate-200 rounded-lg focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all text-sm font-medium" />
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start pt-8 border-t border-slate-50">
                    <div>
                        <h4 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Security & Contact</h4>
                        <p class="text-xs text-slate-400 mt-1 font-medium">Keep your credentials and email up to date.</p>
                    </div>
                    <div class="md:col-span-2 space-y-6">
                        <div>
                            <label for="email" class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1.5">Email Address</label>
                            <input type="email" id="email" name="email" value="" placeholder="Enter new email..."
                                   class="w-full px-4 py-3 bg-white border border-slate-200 rounded-lg focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all text-sm font-medium" />
                        </div>

                        <div>
                            <label for="password" class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1.5">New Password</label>
                            <input type="password" id="password" name="password" placeholder="Leave blank to keep current"
                                   class="w-full px-4 py-3 bg-white border border-slate-200 rounded-lg focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all text-sm font-medium" />
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start pt-8 border-t border-slate-50">
                    <div>
                        <h4 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Public Bio</h4>
                        <p class="text-xs text-slate-400 mt-1 font-medium">Tell the world a bit about yourself.</p>
                    </div>
                    <div class="md:col-span-2">
                        <label for="userAbout" class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1.5">About You</label>
                        <div class="rounded-lg overflow-hidden border border-slate-200 bg-white">
                            <div id="editor-container" style="height: 200px;"></div>
                            <textarea id="userAbout" name="userAbout" rows="10" style="display:none;">@Model.CurrentUser.About</textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="p-6 bg-slate-50/50 flex justify-end">
                <button type="submit" id="saveButton" 
                        class="px-8 py-3.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl shadow-lg shadow-blue-500/20 hover:shadow-xl hover:-translate-y-0.5 transition-all uppercase tracking-wider text-xs">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>
