@model AlwaysMoveForward.AnotherBlog.Web.Areas.Admin.Models.UserModel
@using AlwaysMoveForward.Common.DomainModel;
@using AlwaysMoveForward.AnotherBlog.Common.DomainModel
@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminToolLayout.cshtml";
}
 @section headerPlugins
 {
     <script src="@Url.Content("~/Scripts/Admin/ManageUsers.js")" type="text/javascript"></script>

     <script type="text/javascript">
        $(document).ready(function () {
            $("button[name=addButton]").click(function () {
                document.location.href = "/Admin/UserManagement/Edit";
            });
        });
    </script>
}
<div class="bodyContent">        
    <div class="panel panel-default">
        <div class="panel-heading">
            <h3 class="panel-title">Manage Users</h3>
        </div>
        <div class="panel-body">
            <button type="button" class="btn btn-primary" name="addButton">Add User</button>
            <br /><br />
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th width="20%">User</th>
                        <th>&nbsp;</th>
                    </tr>
                </thead>
                <tbody>
                @{
                    foreach (AnotherBlogUser blogUser in @Model.Users)
                    {   
                        <tr>
                            <td><a href="/Admin/UserManagement/Edit/@blogUser.Id.ToString()">@blogUser.GetDisplayName()</a></td>
                            <td><a href="/Admin/UserManagement/Delete?userId=@blogUser.Id.ToString()"><img src="@Url.Content("~/Content/images/action_delete.png")" class="deleteComment" alt="" /></a></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
            <div class="pt-6">
                @Html.PagedListPager(Model.Users, page => Url.Action("Index", new { page }), new PagedListRenderOptions
                {
                    UlElementClasses = new[] { "flex", "justify-center", "gap-1" },
                    LiElementClasses = new[] { "list-none" },
                    PageClasses = new[] { "flex", "items-center", "justify-center", "min-w-[40px]", "h-10", "px-3", "rounded-lg", "border", "border-slate-200", "bg-white", "text-sm", "font-semibold", "text-slate-700", "hover:bg-slate-50", "hover:border-slate-300", "transition-all" },
                    ActiveLiElementClass = "[&>a]:bg-blue-600 [&>a]:text-white [&>a]:border-blue-600 [&>span]:bg-blue-600 [&>span]:text-white [&>span]:border-blue-600"
                })
            </div>
            <button type="button" class="btn btn-primary" name="addButton">Add User</button>
        </div>
    </div>
</div>