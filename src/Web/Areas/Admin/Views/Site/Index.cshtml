@model AlwaysMoveForward.AnotherBlog.Web.Areas.Admin.Models.SiteModel
@using AlwaysMoveForward.Common.DomainModel;           
@using AlwaysMoveForward.AnotherBlog.Common.DomainModel
@using AlwaysMoveForward.AnotherBlog.Web.Code.Utilities
@inject IWebHostEnvironment _Environment;
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminToolLayout.cshtml";
}

@section headerPlugins
{
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <script>
        $(document).ready(function() {
            var quill = new Quill('#editor-container', {
                theme: 'snow',
                modules: {
                    toolbar: [
                        [{ 'header': [1, 2, false] }],
                        ['bold', 'italic', 'underline'],
                        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                        ['link', 'image'],
                        ['clean']
                    ]
                }
            });

            quill.root.innerHTML = $('#siteAbout').val();

            quill.on('text-change', function() {
                var html = quill.root.innerHTML;
                $('#siteAbout').val(html);
            });
        });
    </script>
}
<div class="bodyContent">        
    <div class="panel panel-primary">
        <div class="panel-heading">
            <h3 class="panel-title">Edit Site Info</h3>
        </div>
        <div class="panel-body">
            <form action='/Admin/Site/Edit' method="post">
                <div class="form-group">
                    <label for="siteName">Name:</label>
                    <input type="text" id="siteName" name="siteName" value="@Model.SiteInfo.Name" maxlength="50" class="form-control" />
                    @Html.ValidationMessage("siteName")
                </div>
                <div class="form-group">
                    <label for="siteContact">Contact Email:</label>
                    <input type="text" id="siteContact" name="siteContact" value="@Model.SiteInfo.ContactEmail" maxlength="50" class="form-control" />
                    @Html.ValidationMessage("siteContact")
                </div>
                <div class="form-group">
                    <label for="siteAnalytics">Site Analytics ID:</label>
                    <input type="text" id="siteAnalytics" name="siteAnalyticsId" value="@Model.SiteInfo.SiteAnalyticsId" maxlength="50" class="form-control" />
                    @Html.ValidationMessage("siteAnalyticsId")
                </div>
                <div class="form-group">
                    <label for="defaultAuthor">Default Author:</label>
                    <input type="text" id="defaultAuthor" name="defaultAuthor" value="@Model.SiteInfo.DefaultAuthor" maxlength="50" class="form-control" />
                    @Html.ValidationMessage("defaultAuthor")
                </div>
                <div class="form-group">
                    <label for="defaultKeywords">Default Keywords:</label>
                    <input type="text" id="defaultKeywords" name="defaultKeywords" value="@Model.SiteInfo.DefaultKeywords" maxlength="100" class="form-control" />
                    @Html.ValidationMessage("defaultKeywords")
                </div>
                <div class="form-group">
                    <label for="defaultTheme">Default Theme:</label>
                    <select id="defaultTheme" name="defaultTheme" class="form-control">
                        @foreach (string themeDirectory in Utils.GetThemeDirectories(_Environment.ContentRootPath))
                        {
                            <!option id="@themeDirectory" name="@themeDirectory" value="@themeDirectory" @(themeDirectory == Model.SiteInfo.DefaultTheme ? "selected" : "")>@themeDirectory</!option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label for="siteAbout">About:</label>
                    <div id="editor-container" style="height: 300px; background-color: white;"></div>
                    <textarea id="siteAbout" name="siteAbout" class="form-control" rows="15" style="display:none;">@Model.SiteInfo.About</textarea>
                </div>
                <br />
                <button type="submit" id="saveButton" class="btn btn-primary">Save Changes</button>
            </form>
        </div>
    </div>
</div>
